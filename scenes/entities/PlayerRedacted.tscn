[sub_resource type="GDScript" id="GDScript_b5ydt"]
script/source = "extends CharacterBody2D

class_name Player

enum State { MOVE, PUNCH, PICKUP, DEATH, ATTACK }

@export var MAX_SPEED: float = 200.0
@export var ACCELERATION: float = 1500.0
@export var FRICTION: float = 1200.0
@export var max_health: int = 30

var health: int = 100

const BULLET_SCENE: PackedScene = preload(\"res://scenes/props/Bullet.tscn\")

@onready var body_sprite: AnimatedSprite2D = $BodySprite
@onready var body_nohands_sprite: AnimatedSprite2D = $BodyNoHandsSprite
@onready var helmet_sprite: AnimatedSprite2D = $HelmetSprite
@onready var bat_sprite: AnimatedSprite2D = $BatSprite
@onready var gun_sprite: AnimatedSprite2D = $GunSprite
@onready var pistol_sprite: AnimatedSprite2D = $PistolSprite
@onready var shotgun_sprite: AnimatedSprite2D = $ShotgunSprite
@onready var fire_sprite: AnimatedSprite2D = $FireSprite
@onready var hitbox: PlayerHitbox = $Hitbox
@onready var hitbox_shape: CollisionShape2D = $Hitbox/CollisionShape2D

var axis: Vector2 = Vector2.ZERO
var state: State = State.MOVE
var facing: String = \"down\"
var weapon_type: int = 0  # 0=none, 1=bat, 2=gun, 3=shotgun, 4=pistol
var helmet_on: bool = true
var active_body_sprite: AnimatedSprite2D

func _ready() -> void:
	add_to_group(\"player\")
	health = max_health
	active_body_sprite = body_sprite

	# Kondisi awal: tidak membawa senjata
	weapon_type = 0

	body_sprite.visible = true
	body_nohands_sprite.visible = false

	# Pastikan animasi awal berjalan
	body_sprite.play(\"idle_down\")

	# Helmet
	helmet_sprite.visible = helmet_on
	_sync_helmet()

	# Connect signal
	body_sprite.animation_finished.connect(_on_animation_finished)
	body_nohands_sprite.animation_finished.connect(_on_animation_finished)
	bat_sprite.animation_finished.connect(_on_weapon_animation_finished)
	gun_sprite.animation_finished.connect(_on_weapon_animation_finished)
	shotgun_sprite.animation_finished.connect(_on_weapon_animation_finished)
	pistol_sprite.animation_finished.connect(_on_weapon_animation_finished)
	fire_sprite.animation_finished.connect(_on_fire_finished)
	

func _physics_process(delta: float) -> void:
	if state == State.DEATH or state == State.ATTACK:
		return

	move(delta)
	update_animation()


# -------> Movement System <------- #

func get_input_axis() -> Vector2:
	axis.x = int(Input.is_action_pressed(\"move_right\")) - int(Input.is_action_pressed(\"move_left\"))
	axis.y = int(Input.is_action_pressed(\"move_down\")) - int(Input.is_action_pressed(\"move_up\"))

	return axis.normalized()


func move(delta: float) -> void:
	axis = get_input_axis()

	if axis == Vector2.ZERO:
		apply_friction(FRICTION * delta)
	else:
		apply_movement(ACCELERATION * axis * delta)

	move_and_slide()


func apply_movement(accel: Vector2) -> void:
	velocity += accel
	velocity = velocity.limit_length(MAX_SPEED)


func apply_friction(amount: float) -> void:
	if velocity.length() > amount:
		velocity -= velocity.normalized() * amount
	else:
		velocity = Vector2.ZERO

# -------> End of Movement System <------- #


# -------> Animation System <------- #

func update_animation() -> void:
	if state != State.MOVE:
		return

	var new_facing: String = get_facing()

	if new_facing != \"\":
		facing = new_facing

	if velocity.length() > 1.0:
		_play(\"run_\" + facing)
	else:
		_play(\"idle_\" + facing)

	_sync_weapon()
	_sync_helmet()


func get_facing() -> String:
	var h: int = int(Input.is_action_pressed(\"move_right\")) - int(Input.is_action_pressed(\"move_left\"))
	var v: int = int(Input.is_action_pressed(\"move_down\")) - int(Input.is_action_pressed(\"move_up\"))

	if h > 0:
		return \"right\"

	if h < 0:
		return \"left\"

	if v > 0:
		return \"down\"

	if v < 0:
		return \"up\"

	return \"\"


func punch() -> void:
	if state != State.MOVE:
		return

	state = State.PUNCH
	_play(\"punch_\" + facing)
	_sync_helmet()


func pickup() -> void:
	if state != State.MOVE:
		return

	state = State.PICKUP
	_play(\"pickup_\" + facing)
	# If armed, shift the weapon to its pickup offset while bending down.
	if weapon_type != 0:
		var ws: AnimatedSprite2D = _weapon_sprite()
		ws.position = _weapon_offset(\"pickup\")
	_sync_helmet()


## Called when an enemy hits the player. Reduces health and dies at 0.
func take_damage(amount: int) -> void:
	if state == State.DEATH:
		return
	health -= amount
	if health <= 0:
		health = 0
		die()


func die() -> void:
	state = State.DEATH
	hitbox.deactivate()
	# Body death only has side(up/down→right) and side_left. Map accordingly.
	var body_dir: String = facing
	if body_dir == \"down\" or body_dir == \"up\":
		body_dir = \"right\"
	_play(\"death_\" + body_dir)
	# Play the matching weapon death animation when armed.
	if weapon_type != 0:
		_play_weapon_death()
	_sync_helmet()


# Weapon death only has side and side_left; map up/down to side (death right).
func _death_dir() -> String:
	match facing:
		\"left\":
			return \"side_left\"
		_:
			# down, up and right all map to \"side\" (death to the right)
			return \"side\"


func _play_weapon_death() -> void:
	var prefix: String = \"\"
	var sprite: AnimatedSprite2D = gun_sprite
	match weapon_type:
		1: prefix = \"bat\"; sprite = bat_sprite
		2: prefix = \"gun\"; sprite = gun_sprite
		3: prefix = \"shotgun\"; sprite = shotgun_sprite
		4: prefix = \"pistol\"; sprite = pistol_sprite
	var ddir: String = _death_dir()
	var danim: String = prefix + \"_\" + ddir + \"_death\"
	if sprite.sprite_frames.has_animation(danim):
		sprite.play(danim)
	# Apply the per-action death offset
	sprite.position = _weapon_offset(\"death\")


func _on_animation_finished() -> void:
	if state == State.PUNCH or state == State.PICKUP or state == State.ATTACK:
		state = State.MOVE
		hitbox.deactivate()
		_sync_helmet()


func _play(anim_name: String) -> void:
	if active_body_sprite.animation != anim_name:
		active_body_sprite.play(anim_name)
		


# -------> End of Animation System <------- #


# -------> Attacking System <------- #

func attack() -> void:
	if state != State.MOVE:
		return

	state = State.ATTACK

	if weapon_type == 0:
		# Unarmed: body punch animation + melee hitbox (like the bat).
		_play(\"punch_\" + facing)
		_position_bat_hitbox()
		hitbox.activate()
		_sync_helmet()
		return

	# Armed: play weapon attack/shoot animation
	var prefix: String = \"\"
	var sprite: AnimatedSprite2D = gun_sprite
	match weapon_type:
		1: prefix = \"bat\"; sprite = bat_sprite
		2: prefix = \"gun\"; sprite = gun_sprite
		3: prefix = \"shotgun\"; sprite = shotgun_sprite
		4: prefix = \"pistol\"; sprite = pistol_sprite

	var action: String = \"_attack\" if weapon_type == 1 else \"_shoot\"
	var wanim: String = prefix + \"_\" + _weapon_dir() + action
	sprite.play(wanim)
	# Apply the per-action offset (attack for bat, shoot for guns)
	sprite.position = _weapon_offset(\"attack\" if weapon_type == 1 else \"shoot\")

	# Muzzle flash for guns
	if weapon_type >= 2:
		_play_fire()

	# Guns: fire bullet projectile(s) from the muzzle.
	if weapon_type == 2 or weapon_type == 3 or weapon_type == 4:
		_spawn_bullet()

	# Bat: activate the melee hitbox in front of the player for the swing.
	if weapon_type == 1:
		_position_bat_hitbox()
		hitbox.activate()


# World position just outside the gun's barrel (where the muzzle flash appears).
func _muzzle_global() -> Vector2:
	var cfg: Dictionary = FIRE_OFFSETS.get(weapon_type, {})
	var muzzle: Vector2 = cfg.get(_weapon_dir(), Vector2.ZERO)
	return global_position + (_weapon_sprite().position + muzzle)

func _facing_vec() -> Vector2:
	match facing:
		\"right\":
			return Vector2.RIGHT
		\"left\":
			return Vector2.LEFT
		\"down\":
			return Vector2.DOWN
		\"up\":
			return Vector2.UP
	return Vector2.RIGHT

# Per-weapon bullet configuration:
#   damage  -> damage dealt per bullet/pellet
#   pellets -> how many projectiles are fired at once
#   spread  -> total fan spread in degrees around the aim direction (for pellets)
#   range   -> max travel distance before the bullet vanishes (<=0 = unlimited)
const BULLET_CONFIG: Dictionary = {
	2: { \"damage\": 20,  \"pellets\": 1, \"spread\": 0.0,  \"range\": -1.0 },  # Gun
	3: { \"damage\": 8,   \"pellets\": 3, \"spread\": 14.0, \"range\": 320.0 }, # Shotgun: weak pellets, spread, short range
	4: { \"damage\": 10,  \"pellets\": 1, \"spread\": 0.0,  \"range\": -1.0 },  # Pistol: half the gun's damage
}

func _spawn_bullet() -> void:
	var cfg: Dictionary = BULLET_CONFIG.get(weapon_type, BULLET_CONFIG[2])
	var damage: int = cfg.get(\"damage\", 20)
	var pellets: int = cfg.get(\"pellets\", 1)
	var spread: float = deg_to_rad(cfg.get(\"spread\", 0.0))
	var bullet_range: float = cfg.get(\"range\", -1.0)
	var base_dir: Vector2 = _facing_vec()
	var muzzle: Vector2 = _muzzle_global()

	for i in pellets:
		var b: Bullet = BULLET_SCENE.instantiate()
		b.global_position = muzzle
		b.damage = damage
		b.max_range = bullet_range
		# Fan multiple pellets evenly around the aim direction.
		var dir: Vector2 = base_dir
		if pellets > 1:
			var offset: float = spread * float(i - (pellets - 1) / 2.0)
			dir = base_dir.rotated(offset)
		b.setup(dir)
		get_tree().current_scene.add_child(b)


# Moves the melee hitbox to the front of the player based on facing.
# The Hitbox node stays at the player origin; only the shape is offset.
# The right value (29, 0.25) is what you tuned in the editor — the other
# directions mirror it around the player.
func _position_bat_hitbox() -> void:
	hitbox.position = Vector2.ZERO
	match facing:
		\"right\":
			hitbox_shape.position = Vector2(15, 0.25)
		\"left\":
			hitbox_shape.position = Vector2(-15, 0.25)
		\"down\":
			hitbox_shape.position = Vector2(0.25, 15)
		\"up\":
			hitbox_shape.position = Vector2(0.25, -15)


func _on_weapon_animation_finished() -> void:
	if state == State.ATTACK:
		state = State.MOVE
		hitbox.deactivate()
		_sync_weapon()
		_sync_helmet()


# -------> Weapon System <------- #

# Position offsets for each weapon sprite per direction AND per action.
# Format: weapon_type -> action -> {direction: Vector2(x, y)}
# Actions: \"idle\", \"attack\" (bat) / \"shoot\" (guns), \"reload\", \"death\", \"pickup\", \"punch\".
# Any action not listed for a direction falls back to its \"idle\" offset.
# Death only has \"side\"/\"side_left\" (up/down map to side).
const WEAPON_OFFSETS: Dictionary = {
	1: {  # Bat
		\"idle\":    {\"down\": Vector2(-8, 0), \"up\": Vector2(8, 0), \"side\": Vector2(-8, 0), \"side_left\": Vector2(8, 0)},
		\"attack\":  {\"down\": Vector2(-6, 0), \"up\": Vector2(6, 0), \"side\": Vector2(-6, 0), \"side_left\": Vector2(6, 0)},
		\"pickup\":  {\"down\": Vector2(-8, 0), \"up\": Vector2(8, 0), \"side\": Vector2(-8, 0), \"side_left\": Vector2(8, 0)},
		\"death\":   {\"side\": Vector2(-8, 0), \"side_left\": Vector2(8, 0)},
	},
	2: {  # Gun
		\"idle\":    {\"down\": Vector2(-10, 10), \"up\": Vector2(15, -5), \"side\": Vector2(10, 8), \"side_left\": Vector2(-10, 8)},
		\"shoot\":   {\"down\": Vector2(-8, 10), \"up\": Vector2(13, -5), \"side\": Vector2(12, 8), \"side_left\": Vector2(-12, 8)},
		\"reload\":  {\"down\": Vector2(-10, 10), \"up\": Vector2(15, -5), \"side\": Vector2(10, 8), \"side_left\": Vector2(-10, 8)},
		\"pickup\":  {\"down\": Vector2(-10, 10), \"up\": Vector2(15, -5), \"side\": Vector2(10, 8), \"side_left\": Vector2(-10, 8)},
		\"death\":   {\"side\": Vector2(0, 0), \"side_left\": Vector2(0, 0)},
	},
	3: {  # Shotgun
		\"idle\":    {\"down\": Vector2(-10, 0), \"up\": Vector2(15, -5), \"side\": Vector2(5, 0), \"side_left\": Vector2(-7, 0)},
		\"shoot\":   {\"down\": Vector2(-8, 0), \"up\": Vector2(13, -5), \"side\": Vector2(8, 0), \"side_left\": Vector2(8, 0)},
		\"reload\":  {\"down\": Vector2(-10, 0), \"up\": Vector2(15, -5), \"side\": Vector2(5, 0), \"side_left\": Vector2(5, 0)},
		\"pickup\":  {\"down\": Vector2(-10, 0), \"up\": Vector2(15, -5), \"side\": Vector2(5, 0), \"side_left\": Vector2(5, 0)},
		\"death\":   {\"side\": Vector2(0, 0), \"side_left\": Vector2(0, 0)},
	},
	4: {  # Pistol
		\"idle\":    {\"down\": Vector2(-5, 5), \"up\": Vector2(10, -3), \"side\": Vector2(8, 5), \"side_left\": Vector2(-8, 5)},
		\"shoot\":   {\"down\": Vector2(-3, 5), \"up\": Vector2(8, -3), \"side\": Vector2(10, 5), \"side_left\": Vector2(-10, 5)},
		\"reload\":  {\"down\": Vector2(-5, 5), \"up\": Vector2(10, -3), \"side\": Vector2(8, 5), \"side_left\": Vector2(-8, 5)},
		\"pickup\":  {\"down\": Vector2(-5, 5), \"up\": Vector2(10, -3), \"side\": Vector2(8, 5), \"side_left\": Vector2(-8, 5)},
		\"death\":   {\"side\": Vector2(0, 0), \"side_left\": Vector2(0, 0)},
	},
}

# Returns the offset for the current weapon + direction + action, falling back
# to the weapon's \"idle\" offset for any action/direction that isn't configured.
func _weapon_offset(action: String) -> Vector2:
	var weapon_cfg: Dictionary = WEAPON_OFFSETS.get(weapon_type, {})
	var action_cfg: Dictionary = weapon_cfg.get(action)
	if action_cfg == null:
		action_cfg = weapon_cfg.get(\"idle\", {})
	# Death uses the side/side_left death direction mapping.
	var dir: String = _death_dir() if action == \"death\" else _weapon_dir()
	return action_cfg.get(dir, Vector2.ZERO)

# Helmet offset per direction
const HELMET_OFFSETS: Dictionary = {
	\"down\": Vector2(0, -6),
	\"up\": Vector2(0, -6),
	\"side\": Vector2(1, -6),
	\"side_left\": Vector2(-1, -6),
}

# Muzzle flash offset per weapon type + direction. These are measured from
# each weapon sprite's own origin out to the barrel tip, so the flash lands
# right at the muzzle. Longer weapons need larger values.
# Format: weapon_type -> {direction: Vector2(x, y)}
const FIRE_OFFSETS: Dictionary = {
	1: {  # Bat (no muzzle, but kept for safety)
		\"down\": Vector2(0, 0), \"up\": Vector2(0, 0), \"side\": Vector2(0, 0), \"side_left\": Vector2(0, 0),
	},
	2: {  # Gun (medium length)
		\"down\": Vector2(0, 18), \"up\": Vector2(0, -18), \"side\": Vector2(30, -7), \"side_left\": Vector2(-30, -7),
	},
	3: {  # Shotgun (longest)
		\"down\": Vector2(0, 24), \"up\": Vector2(0, -24), \"side\": Vector2(32, 0), \"side_left\": Vector2(-32, 0),
	},
	4: {  # Pistol (shortest)
		\"down\": Vector2(0, 12), \"up\": Vector2(0, -12), \"side\": Vector2(16, 0), \"side_left\": Vector2(-16, 0),
	},
}

func _equip_weapon(type: int) -> void:
	weapon_type = type

	# Hide all weapon sprites first
	bat_sprite.visible = false
	gun_sprite.visible = false
	shotgun_sprite.visible = false
	pistol_sprite.visible = false

	var current: String = active_body_sprite.animation

	if type == 0:
		# Unequip: show body with hands, hide no-hands
		body_sprite.visible = true
		body_nohands_sprite.visible = false
		active_body_sprite = body_sprite
		if current != \"\":
			active_body_sprite.play(current)
	else:
		# Equip: show no-hands body + the right weapon
		body_sprite.visible = false
		body_nohands_sprite.visible = true
		active_body_sprite = body_nohands_sprite
		match type:
			1: bat_sprite.visible = true
			2: gun_sprite.visible = true
			3: shotgun_sprite.visible = true
			4: pistol_sprite.visible = true

		if current != \"\":
			active_body_sprite.play(current)
		_sync_weapon()


func _weapon_dir() -> String:
	match facing:
		\"right\":
			return \"side\"
		\"left\":
			return \"side_left\"
		_:
			return facing


# Returns the currently equipped weapon's AnimatedSprite2D.
func _weapon_sprite() -> AnimatedSprite2D:
	match weapon_type:
		1: return bat_sprite
		2: return gun_sprite
		3: return shotgun_sprite
		4: return pistol_sprite
	return gun_sprite


func _sync_weapon() -> void:
	if weapon_type == 0:
		return
	var prefix: String = \"\"
	var sprite: AnimatedSprite2D = gun_sprite
	match weapon_type:
		1: prefix = \"bat\"; sprite = bat_sprite
		2: prefix = \"gun\"; sprite = gun_sprite
		3: prefix = \"shotgun\"; sprite = shotgun_sprite
		4: prefix = \"pistol\"; sprite = pistol_sprite
	var wdir: String = _weapon_dir()
	var wanim: String = prefix + \"_\" + wdir + \"_idle\"
	if sprite.animation != wanim:
		sprite.play(wanim)
	# Apply per-direction/action position offset
	sprite.position = _weapon_offset(\"idle\")


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		attack()
		return

	if not (event is InputEventKey and event.pressed and not event.echo):
		return
	match event.keycode:
		KEY_1: _equip_weapon(1)
		KEY_2: _equip_weapon(2)
		KEY_3: _equip_weapon(3)
		KEY_4: _equip_weapon(4)
		KEY_Q: _equip_weapon(0)  # Change back to hands (unequip)
		KEY_E: pickup()          # Pick-up animation
		KEY_R: die()             # Death animation
		KEY_H: _toggle_helmet()


# -------> Helmet System <------- #

func _toggle_helmet() -> void:
	helmet_on = not helmet_on
	helmet_sprite.visible = helmet_on
	if helmet_on:
		_sync_helmet()


func _sync_helmet() -> void:
	if not helmet_on:
		return
	# Helmet, like the body, only has a side/side_left death animation.
	var hdir: String = _death_dir() if state == State.DEATH else _weapon_dir()
	var haction: String = \"idle\"
	match state:
		State.PUNCH:
			haction = \"punch\"
		State.PICKUP:
			haction = \"pickup\"
		State.DEATH:
			haction = \"death\"
		State.ATTACK:
			if weapon_type == 0:
				haction = \"punch\"
			else:
				haction = \"idle\"
		_:
			haction = \"idle\"
	var hanim: String = \"helmet_\" + hdir + \"_\" + haction
	if not helmet_sprite.sprite_frames.has_animation(hanim):
		hanim = \"helmet_\" + hdir + \"_idle\"
	if helmet_sprite.animation != hanim:
		helmet_sprite.play(hanim)
	var offs: Vector2 = HELMET_OFFSETS.get(hdir, Vector2.ZERO)
	helmet_sprite.position = offs


# -------> Fire / Muzzle Flash <------- #

func _play_fire() -> void:
	var fdir: String = _weapon_dir()
	var fanim: String = \"fire_\" + fdir
	fire_sprite.visible = true
	fire_sprite.play(fanim)
	# Place the flash at the weapon's muzzle: weapon origin + per-weapon muzzle offset.
	var weapon_cfg: Dictionary = FIRE_OFFSETS.get(weapon_type, {})
	var muzzle: Vector2 = weapon_cfg.get(fdir, Vector2.ZERO)
	fire_sprite.position = _weapon_sprite().position + muzzle


func _on_fire_finished() -> void:
	fire_sprite.visible = false
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_rafx0"]
size = Vector2(34, 50)

[sub_resource type="GDScript" id="GDScript_fo2sy"]
script/source = "class_name PlayerHitbox
extends Area2D

## Melee hitbox used by the player's bat attack.
## While active it detects anything in the \"enemies\" group that overlaps it and
## calls take_damage(damage) on it. Each target can only be hit once per swing.

@export var damage: int = 10

var _hit_this_swing: Array[Node] = []

func _ready() -> void:
	monitoring = false
	body_entered.connect(_on_body_entered)
	area_entered.connect(_on_area_entered)

## Called when a bat swing starts. Enables detection and immediately hits any
## enemy already overlapping at the moment the swing begins.
func activate() -> void:
	_hit_this_swing.clear()
	monitoring = true
	for body: Node2D in get_overlapping_bodies():
		_apply_damage(body)
	for area: Area2D in get_overlapping_areas():
		_apply_damage(area)

## Called when the swing ends. Disables detection.
func deactivate() -> void:
	monitoring = false
	_hit_this_swing.clear()

func _on_body_entered(body: Node2D) -> void:
	_apply_damage(body)

func _on_area_entered(area: Area2D) -> void:
	_apply_damage(area)

func _apply_damage(target: Node) -> void:
	if not target.is_in_group(\"enemies\"):
		return
	if _hit_this_swing.has(target):
		return
	if not target.has_method(\"take_damage\"):
		return
	_hit_this_swing.append(target)
	target.take_damage(damage)
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_wp5od"]
